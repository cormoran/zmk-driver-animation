#include "../test.dtsi"
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>
#include <zmk_driver_animation/animation.dtsi>
#include <behaviors/animation_control.dtsi>
#include <dt-bindings/zmk_driver_animation/animation_control.h>

/*
 * Phase C runtime write-through test (DESIGN.md #3.5, #6 scope item 4):
 * pressing animctl's BRIGHT command mutates control.c's in-memory
 * brightness_powered field *and* (CONFIG_ZMK_ANIMATION_CUSTOM_SETTINGS=y)
 * write-throughs to the custom-settings registry (MEMORY mode). This is
 * proven indirectly via a log line (no RPC read-back exists yet - Phase D):
 * CONFIG_ZMK_ANIMATION_SETTINGS_TEST's changed-listener
 * (src/test/animation_settings_test.c) reads the setting back through
 * zmk_custom_setting_read_by_key()-equivalent (zmk_custom_setting_read())
 * and logs the *registry's* effective value, not control.c's own struct
 * field - so a passing "registry brightness_powered=3" log line demonstrates
 * the custom-settings registry itself (not just control state) was updated.
 *
 * default-battery-brightness is 2; one ANIMATION_CONTROL_CMD_BRIGHT +1 press
 * (CURRENT power source, which resolves to "battery" here since
 * CONFIG_USB_DEVICE_STACK is off in this native_sim build -
 * power_policy.c's zmk_animation_power_policy_is_powered() always returns
 * false without it) shifts brightness_battery to 3.
 */

/ {
    mock_led_strip0: mock_led_strip_0 {
        compatible = "zmk,mock-led-strip";
        chain-length = <2>;
    };

    animation: animation {
        compatible = "zmk,animation";
        drivers = <&mock_led_strip0>;
        chain-lengths = <2>;
        pixels = <&pixel 0 0>, <&pixel 1 0>;
    };

    animation_solid0: animation_solid_0 {
        compatible = "zmk,animation-solid";
        pixels = <0 1>;
        colors = <HSL(0, 100, 50)>;
    };

    animation_control0: animation_control_0 {
        compatible = "zmk,animation-control";
        powered-animations = <&animation_solid0>;
        battery-animations = <&animation_solid0>;
        behavior-animations = <&animation_solid0>;
        brightness-steps = <5>;
        default-powered-brightness = <2>;
        default-battery-brightness = <2>;
    };

    chosen {
        zmk,animation = &animation_control0;
        zmk,animation-control = &animation_control0;
    };
};

&kscan {
    events = <
    ZMK_MOCK_PRESS(0,0,50)
    ZMK_MOCK_RELEASE(0,0,50)
    >;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &animctl ANIMATION_CONTROL_CMD_BRIGHT 1
            &kp B
            &kp C
            &kp D
            >;
        };
    };
};
