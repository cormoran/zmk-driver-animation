config ZMK_ANIMATION
    bool "RGB Animations"
    select LED_STRIP

if ZMK_ANIMATION

config ZMK_ANIMATION_FPS
    int "Animation FPS"
    range 1 60
    default 30

config ZMK_ANIMATION_STOP_ON_IDLE
    bool "Whether to stop animation on idle state or not"
    default y

config ZMK_ANIMATION_STUDIO_RPC
    bool "Enable animation feature custom Studio RPC"
    depends on ZMK_STUDIO

config ZMK_ANIMATION_STUDIO_RPC_TEST
    bool "Enable native_sim-only Studio RPC round-trip test hook"
    depends on ZMK_ANIMATION_STUDIO_RPC
    help
      Adds a boot-time self-test (see tests/studio) that calls
      zmk_animation_request_exec_handle() directly (bypassing RPC framing -
      there is no serial/BLE transport in native_sim) for every request kind
      defined in animation.proto, and logs the decoded response fields so
      tests/studio's events.patterns/keycode_events.snapshot mechanism can
      assert on them the same way every other native_sim test in this repo
      does. Also drives a non-RPC state change (calling control.h directly,
      the same path a keymap behavior would use) to prove
      Notification.state_changed fires from that path too, not just from
      RPC-originated mutations.

config ZMK_ANIMATION_CUSTOM_SETTINGS
    bool "Enable animation runtime settings via zmk-feature-custom-settings"
    depends on ZMK_CUSTOM_SETTINGS
    help
      Registers the animation-control state (enabled, powered/battery
      brightness, powered/battery animation selection) as custom settings
      (subsystem "cormoran__animation"), readable/writable over the generic
      custom-settings Studio RPC subsystem and persisted via the Zephyr
      settings subsystem. NOTE: unlike the equivalent PMW3610 option, this
      currently depends on CONFIG_ZMK_ANIMATION itself (nested in this
      `if ZMK_ANIMATION` block): control.h's public API only has a "no
      device" stub definition inside control.c, which is only compiled when
      CONFIG_ZMK_ANIMATION=y (there is no standalone api_stub.c yet - see
      DESIGN.md's Phase D note about adding one for the RPC layer). Revisit
      this dependency once that stub is split out.

config ZMK_ANIMATION_TRIGGER_MAX_PARALLELISM
    int "Maximum number of simultaneously-triggered behavior-animations slots"
    default 10
    help
      v1 spelled this option "...PARALELISM" (typo). Renamed for Phase B;
      see README migration notes if porting a v1 keymap fragment that sets
      this directly (most users only reference the behavior, not this
      Kconfig symbol).

config ZMK_ANIMATION_TRIGGER_MAX_DURATION_MS
    int "Maximum animation play duration for animation trigger"
    default 10000

config ZMK_ANIMATION_TRIGGER_MIN_DURATION_MS
    int "Minimum animation play duration for animation trigger"
    default 1000

config ZMK_ANIMATION_TRIGGER_EXTEND_MS_ON_HOLD
    int "Animation play duration extension on hold"
    default 500

config ZMK_ANIMATION_LAYER_STATUS_SPLIT_TEST
    bool "Enable native_sim-only layer-status split-peripheral test hook"
    depends on ZMK_SPLIT && !ZMK_SPLIT_ROLE_CENTRAL
    help
      Adds a boot-time self-test (see tests/layer_status_peripheral) that
      invokes the `animls` behavior's binding directly - bypassing kscan,
      since a split-peripheral native_sim build forwards raw kscan events
      to the (nonexistent, in this test) central rather than resolving
      keymap bindings locally, so a keymap binding alone cannot exercise
      this path in native_sim. This asserts the real
      on_keymap_binding_pressed/released behavior-invocation path end to
      end, not just the internal zmk_animation_layer_status_set_status()
      call it wraps.

config ZMK_ANIMATION_SETTINGS_TEST
    bool "Enable native_sim-only custom-settings persistence test hook"
    depends on ZMK_ANIMATION_CUSTOM_SETTINGS
    help
      Adds a fake settings backend (see tests/settings_apply) that seeds a
      persisted, non-default value for one animation setting before ZMK's
      main() calls settings_load(), so the test can assert that
      animation-control's boot-time settings-apply step (control.c's
      init-animation delayed work, DESIGN.md #3.5) picks up the persisted
      value rather than the devicetree/Kconfig default - proving the
      boot-ordering fix (this file's SYS_INIT runs at APPLICATION priority
      99, before ZMK's main()/settings_load(), mirroring
      zmk-feature-custom-settings' own CONFIG_ZMK_CUSTOM_SETTINGS_TEST).

config ZMK_ANIMATION_NOTIFY_AMPLIFICATION_TEST
    bool "native_sim-only regression test for the state-changed notification storm"
    depends on ZMK_ANIMATION_SETTINGS_TEST
    help
      Runs an extra hook in the shared animation-settings test init that
      installs a counting state-changed callback, performs a single
      zmk_animation_set_brightness() mutation, and logs how many
      notifications fired. Guards the regression where a mutation re-enters
      apply_all() and amplifies into a burst of state-changed notifications
      (hardware-confirmed to starve that mutation's own RPC Response frame;
      see docs/design/hardware-validation.md). Enabled only in
      tests/settings_write_through, so the mutation it performs does not
      perturb the boot-apply snapshots in tests/settings_apply* (which share
      this same test hook).

endif

config ZMK_ANIMATION_MOCK_LED_STRIP
    bool "Mock LED strip for animation testing"
    depends on ZMK_ANIMATION
    select LED_STRIP
